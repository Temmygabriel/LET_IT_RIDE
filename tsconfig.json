{
  // Type-checking only — we never emit JS here. Vite (frontend) and the Worker
  // bundler do the actual compiling; CI runs `tsc --noEmit` as our compiler
  // since we can't run anything on the dev PC.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    // Our shared src/ imports carry explicit .ts extensions so Deno's native
    // resolver (the runner host) can load them. Safe with noEmit; tsc + Vite
    // both tolerate the extensions too.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src"]
}
